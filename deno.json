{
  "name": "@viviengraffin/translation-react",
  "version": "1.0.3",
  "exports": {
    ".": "./src/main.ts",
    "./context": "./src/context.tsx"
  },
  "imports": {
    "@/":"./src/",
    "@viviengraffin/translation-core":"jsr:@viviengraffin/translation-core@^1.0.0",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "@types/react": "npm:@types/react@^19.2.8",
    "@types/react-dom": "npm:@types/react-dom@^19.2.8",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "happy-dom": "npm:happy-dom@^20.14.5",
    "@testing-library/react": "npm:@testing-library/react@^16.3.3"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable",
      "node",
      "dom"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "tasks": {
    "test": "deno test --allow-env --preload tests/setup.ts"
  },
  "publish": {
    "include": [
      "src/",
      "package.json",
      "deno.json",
      "LICENSE"
    ]
  },
  "nodeModulesDir": "auto"
}
